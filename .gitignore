# This repo is PUBLIC (github.com/cwill713/Movie-Catalog).
# Strategy: ignore everything at the repo root, then explicitly allow what we track.
/*

# --- Tracked at root --------------------------------------------------------
!.gitignore
!/README.md
!/requirements.txt
!/pytest.ini
!/.env.example
!/app/
!/scripts/
!/migrations/
!/tests/

# --- docs/: mostly local, one file published ---------------------------------
# SPEC.md and WORKLOG.md stay on disk - they carry personal detail and this repo
# is public. DECISIONS.md is the exception: it is deliberately scrubbed of
# personal data (enforced by tests/test_decisions_doc.py) and is published.
/docs/
!/docs/
/docs/*
!/docs/DECISIONS.md

# --- Secrets: never track ---------------------------------------------------
.env
.env.*
!.env.example
/API_KEYS.txt

# --- IMDb non-commercial datasets -------------------------------------------
# Licensed for personal, non-commercial use only. Redistribution is prohibited,
# and this repository is public. The dumps and anything derived from them must
# never be committed. We commit scripts/ingest_imdb.py, never the data.
/data/
*.tsv
*.tsv.gz

# --- Databases --------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# --- Python runtime ---------------------------------------------------------
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
